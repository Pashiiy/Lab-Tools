{
  "name": "benchy",
  "private": true,
  "version": "1.1.19",
  "description": "Benchy — Scientific Image Analysis & Research Workspace",
  "author": "Bloom Lab",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pashiiy/Lab-Tools.git"
  },
  "homepage": "https://github.com/Pashiiy/Lab-Tools",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:gel": "node src/apps/gel-quantification/engine/__tests__/fijiValidation.test.mjs",
    "test:persistence": "node src/shared/persistence/__tests__/persistence.test.mjs",
    "test:colony": "node src/apps/colony-counter/utils/__tests__/session.test.mjs",
    "test:colony-accuracy": "node scripts/run-colony-accuracy.mjs",
    "test": "npm run test:gel && npm run test:persistence && npm run test:colony",
    "setup:colony": "node scripts/setup-colony-backend.mjs",
    "colony-api": "node scripts/run-colony-api.mjs",
    "verify:colony-venv": "node scripts/verify-colony-venv.mjs",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.mjs",
    "predist": "npm run generate-icons",
    "predist:win": "npm run generate-icons",
    "predist:mac": "npm run generate-icons",
    "predist:all": "npm run generate-icons",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:all": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 --x64 --win --publish never",
    "verify:mac": "bash scripts/verify-mac.sh",
    "verify:win": "bash scripts/verify-win.sh",
    "validate:lock": "node scripts/validate-lockfile.mjs",
    "sync": "bash scripts/sync-deps.sh",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build:mac": "npm run build && npm run dist:mac",
    "electron:build:win": "npm run build && npm run dist:win",
    "electron:build:all": "npm run dist:all",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "geotiff": "^3.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "utif": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.benchy.app",
    "productName": "Benchy",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/colony_counter",
        "to": "colony_counter",
        "filter": [
          "**/*",
          "!.venv",
          "!.venv/**",
          "!**/__pycache__",
          "!**/__pycache__/**"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "publishAutoUpdate": false
    },
    "mac": {
      "category": "public.app-category.medical",
      "icon": "public/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "electronLanguages": [
        "en"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "public/icon.ico",
      "target": "nsis",
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    }
  }
}
